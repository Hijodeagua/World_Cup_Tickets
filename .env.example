# Local dev uses SQLite. For production, set a Postgres URL and switch the
# datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Shared secret required to trigger the refresh cron endpoint.
# Vercel Cron sends this automatically when configured; set any random string.
CRON_SECRET="change-me-in-prod"

# Free Ticketmaster Discovery API key (https://developer.ticketmaster.com).
# Optional: without it the Ticketmaster provider degrades cleanly to UNKNOWN.
TICKETMASTER_API_KEY=""

# Free SeatGeek Platform API credentials (https://seatgeek.com/build). The
# provider is tiered: it queries the SeatGeek API first, then falls back to
# schema.org JSON-LD on the matched event page. Optional: without a client id
# the SeatGeek provider degrades cleanly to UNKNOWN. The secret is optional.
SEATGEEK_CLIENT_ID=""
SEATGEEK_CLIENT_SECRET=""

# Free match-odds API key (https://the-odds-api.com). Optional: powers the
# market lines in the per-match "Matchup forecast". Without it the forecast
# still renders from our own Elo head-to-head simulation.
THE_ODDS_API_KEY=""
