// World Cup 2026 — match predictions data model.
//
// Uses Postgres in every environment (local and production) so the committed
// schema always matches the live deployment. "enum" fields are kept as String
// constrained in app code. Point DATABASE_URL at any Postgres instance (local
// Docker, Neon, Vercel Postgres, etc.).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Team {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  group       String?
  flag        String?
  confirmed   Boolean @default(true)
  homeMatches Match[] @relation("home")
  awayMatches Match[] @relation("away")
}

model Venue {
  id       String  @id @default(cuid())
  city     String
  country  String
  stadium  String  @unique
  capacity Int?
  matches  Match[]
}

model Match {
  id          String   @id @default(cuid())
  fifaMatchNo Int      @unique
  kickoff     DateTime
  stage       String
  group       String?
  confirmed   Boolean  @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  homeTeamId String?
  homeTeam   Team?   @relation("home", fields: [homeTeamId], references: [id])
  awayTeamId String?
  awayTeam   Team?   @relation("away", fields: [awayTeamId], references: [id])

  // Labels for knockout placeholders ("Winner Group A", "Runner-up B", ...).
  homeLabel String?
  awayLabel String?

  // Result, once played. Populated by the nightly results sync; drives the
  // group standings and conditions the Elo projections on actual outcomes.
  status    String @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED
  homeScore Int?
  awayScore Int?

  @@index([kickoff])
}

// Frozen per-match Elo prediction. The nightly predictions cron computes a
// win/draw/loss split for every upcoming fixture with both teams known, and
// FREEZES it the night before kickoff (see lib/predictions/matchPredictions.ts).
// Once frozen — or once the match has been played — the row is never recomputed,
// so the model is always graded against the prediction it actually made before
// the game (app/accuracy).
model MatchPrediction {
  matchId     String   @id
  fifaMatchNo Int      @unique
  homeCode    String?
  awayCode    String?
  eloA        Int
  eloB        Int
  pWinA       Float
  pDraw       Float
  pWinB       Float
  iterations  Int
  frozen      Boolean  @default(false)
  computedAt  DateTime @updatedAt

  @@index([fifaMatchNo])
}

// Elo Monte Carlo projection per team. Recomputed by scripts/predict.ts.
model TeamProjection {
  code         String   @id
  group        String
  elo          Int
  pGroupWinner Float
  pQualify     Float
  pR16         Float
  pQF          Float
  pSF          Float
  pFinal       Float
  pChampion    Float
  iterations   Int
  computedAt   DateTime @updatedAt
}

// Auto-pulled squad rows (currently from Wikipedia). The editable
// data/rosters.json layer is merged on top at read time as manual overrides,
// so hand-entered fields (assists, league, debut year) win over fetched data.
// Wikipedia squad tables provide name/position/caps/goals/club; the other
// fields stay null until a manual override or a richer source fills them.
model Player {
  id           String   @id @default(cuid())
  teamCode     String
  name         String
  position     String // GK | DF | MF | FW
  club         String?
  league       String?
  caps         Int?
  goals        Int?
  assists      Int?
  firstCapYear Int?
  source       String   @default("wikipedia")
  fetchedAt    DateTime @default(now())

  @@unique([teamCode, name])
  @@index([teamCode])
}

