# Local dev uses SQLite. For production, set a Postgres URL and switch the
# datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Shared secret required to trigger the refresh cron endpoint.
# Vercel Cron sends this automatically when configured; set any random string.
CRON_SECRET="change-me-in-prod"

# Free Ticketmaster Discovery API key (https://developer.ticketmaster.com).
# Optional: without it the Ticketmaster provider degrades cleanly to UNKNOWN.
TICKETMASTER_API_KEY=""
