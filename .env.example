# Postgres connection string (used in both local dev and production so the
# committed schema always matches the live deployment). Point this at any
# Postgres instance — local Docker, Neon, Vercel Postgres, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/worldcup?schema=public"

# Shared secret required to trigger the cron endpoints.
# Vercel Cron sends this automatically when configured; set any random string.
CRON_SECRET="change-me-in-prod"

# Free match-odds API key (https://the-odds-api.com). Optional: powers the
# market lines in the per-match "Matchup forecast". Without it the forecast
# still renders from our own Elo head-to-head simulation.
THE_ODDS_API_KEY=""
